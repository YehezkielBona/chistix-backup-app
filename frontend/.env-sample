# ================== CONTOH ENV FRONTEND ==================
# Salin menjadi "frontend/.env.local" lalu isi.
# Hanya variabel NON-RAHASIA di sini. Rahasia (DB, secret) ada di backend/.env

# Alamat frontend (dipakai Better Auth client)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alamat server Express. Next.js meneruskan (proxy) semua /api/* ke sini.
BACKEND_URL=http://localhost:4000
