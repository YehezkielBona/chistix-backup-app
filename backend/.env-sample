# ================== CONTOH ENV BACKEND ==================
# Cara pakai: salin file ini menjadi "backend/.env" lalu isi nilainya.
#   PowerShell:  Copy-Item backend/.env-sample backend/.env
# JANGAN commit file .env asli (sudah di-ignore oleh .gitignore).

PORT=4000
NODE_ENV=development

# --- Database (Neon PostgreSQL) ---
# Ambil dari Neon Console > project > Connect.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"

# --- Alamat frontend (CORS, Better Auth, link email) ---
FRONTEND_URL=http://localhost:3000

# --- Better Auth ---
# BETTER_AUTH_URL = alamat FRONTEND (browser lewat :3000, lalu di-proxy ke Express).
BETTER_AUTH_URL=http://localhost:3000
# String acak panjang. Contoh bikin:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# --- Email (Gmail SMTP + App Password) ---
# App Password: myaccount.google.com > Security > 2-Step Verification > App passwords
EMAIL_USER=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Google OAuth (opsional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (image hosting) ---
# Ambil dari cloudinary.com > Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chistix

# --- Emsifa (data wilayah Indonesia, publik, tanpa API key) ---
EMSIFA_BASE_URL=https://www.emsifa.com/api-wilayah-indonesia/api
