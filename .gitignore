# ============================================================
# .gitignore untuk monorepo Chistix (frontend/ + backend/)
# Catatan: pola TANPA "/" di depan berlaku di SEMUA subfolder.
# ============================================================

# --- dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- build output ---
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- testing ---
coverage/

# --- env (RAHASIA, jangan pernah di-commit) ---
.env
.env.*
# ...kecuali file contoh (isinya kosong / placeholder)
!.env-sample
!.env.example

# --- misc ---
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- deploy ---
.vercel

# catatan kredensial lokal (berisi secret Google) - jangan di-commit
O-A-u-t-h-google.md
